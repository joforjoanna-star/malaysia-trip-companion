  TO anon, authenticated USING (true);

-- Seed starter content only when tables are empty -------------------------
DO $$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM packing_items) THEN
    INSERT INTO packing_items (label, done) VALUES
      ('Passport + MDAC confirmation', false),
      ('AirAsia e-ticket / boarding pass', false),
      ('Touch ''n Go card (or top-up app)', false),
      ('Grab app set up + payment linked', false),
      ('Adapter (Type G plug)', false),
      ('Light rain layer (humid, sudden showers)', false);
  END IF;

  IF NOT EXISTS (SELECT 1 FROM itinerary_items) THEN
    INSERT INTO itinerary_items (day, time, activity) VALUES
      ('Day 1', 'Arrival', 'Land KLIA -> KLIA Ekspres -> Bukit Bintang hotel'),
      ('Day 2', 'Full day', 'Klook full-day KL city tour');
  END IF;

  IF NOT EXISTS (SELECT 1 FROM documents) THEN
    INSERT INTO documents (title, link, notes) VALUES
      ('AirAsia flight booking', '', 'Bangalore -> KL'),
      ('Bukit Bintang hotel booking', '', ''),
      ('MDAC (Malaysia Digital Arrival Card)', '', 'Submit within 3 days before arrival');
  END IF;

  IF NOT EXISTS (SELECT 1 FROM places) THEN
    INSERT INTO places (name, notes, link) VALUES
      ('Bukit Bintang', 'Base / shopping / food street', ''),
      ('Batu Caves', '', ''),
      ('Petronas Towers', 'Book skybridge slot ahead if wanted', '');
  END IF;
END $$;

INSERT INTO trip_notes (id, content) VALUES (1, '')
  ON CONFLICT (id) DO NOTHING;
