/*
# Malaysia Trip Companion — initial schema

1. Purpose
   Persists a single traveler's trip data: packing checklist, day-by-day
   itinerary, travel documents, saved places, a photo moodboard, and
   freeform notes. Single-tenant (no sign-in), so all data is shared and
   readable/writable by the anon-key frontend.

2. New Tables
   - packing_items    (id, label, done, created_at)        — checklist rows
   - itinerary_items  (id, day, time, activity, created_at) — day plans
   - documents        (id, title, link, notes, created_at)  — tickets/bookings
   - places           (id, name, notes, link, created_at)   — saved locations
   - moodboard_photos (id, src, caption, created_at)        — base64 inspiration photos
   - trip_notes       (id, content, updated_at)             — one freeform notes row

3. Security
   - RLS enabled on every table.
   - Single-tenant app with NO sign-in screen, so every policy is scoped to
     `TO anon, authenticated` with `USING (true)` / `WITH CHECK (true)`:
     the data is intentionally shared across the one trip.

4. Seed data
   - packing_items, itinerary_items, documents, places are seeded with
     starter content ONLY when the table is empty (first run).
   - trip_notes is seeded with one empty row so the singleton always exists.
*/

-- packing_items -----------------------------------------------------------
CREATE TABLE IF NOT EXISTS packing_items (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  label text NOT NULL,
  done boolean NOT NULL DEFAULT false,
  created_at timestamptz NOT NULL DEFAULT now()
);
ALTER TABLE packing_items ENABLE ROW LEVEL SECURITY;

DROP POLICY IF EXISTS "anon_select_packing" ON packing_items;
CREATE POLICY "anon_select_packing" ON packing_items FOR SELECT
  TO anon, authenticated USING (true);
DROP POLICY IF EXISTS "anon_insert_packing" ON packing_items;
CREATE POLICY "anon_insert_packing" ON packing_items FOR INSERT
  TO anon, authenticated WITH CHECK (true);
DROP POLICY IF EXISTS "anon_update_packing" ON packing_items;
CREATE POLICY "anon_update_packing" ON packing_items FOR UPDATE
  TO anon, authenticated USING (true) WITH CHECK (true);
DROP POLICY IF EXISTS "anon_delete_packing" ON packing_items;
CREATE POLICY "anon_delete_packing" ON packing_items FOR DELETE
  TO anon, authenticated USING (true);

